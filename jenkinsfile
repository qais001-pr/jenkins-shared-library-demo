@Library('jenkins-shared-library') _

pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkoutCode()
            }
        }

        stage('Build') {
            steps {
                buildApp()
            }
        }

        stage('Test') {
            steps {
                testApp()
            }
        }

        stage('Deploy') {
            steps {
                deployApp()
            }
        }
    }
}